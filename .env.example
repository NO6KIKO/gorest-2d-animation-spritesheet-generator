# Optional.
# The current local spritesheet and scene editing workflow does not require an API key.
# Set this only when calling /api/spritesheet/generate with provider: "atlas-cloud".
ATLASCLOUD_API_KEY=""
ATLASCLOUD_MEDIA_API_BASE="https://api.atlascloud.ai/api/v1"
ATLASCLOUD_IMAGE_MODEL="bytedance/seedream-v5.0-lite"

# Reserved for legacy Gemini experiments. The current cloud spritesheet route uses Atlas Cloud.
GEMINI_API_KEY=""

# Optional local server port. Defaults to 3000.
PORT=3000
